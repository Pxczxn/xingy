# ============================================================
# 默认文本规则
# Windows 开发 + Linux / Docker 部署时，普通文本统一 LF
# ============================================================

* text=auto eol=lf


# ============================================================
# Windows 专属脚本
# ============================================================

*.bat text eol=crlf
*.cmd text eol=crlf


# ============================================================
# 常见文本文件
# ============================================================

*.java text
*.kt text
*.py text

*.js text
*.jsx text
*.ts text
*.tsx text
*.vue text
*.mjs text
*.cjs text

*.json text
*.xml text
*.yml text
*.yaml text
*.toml text
*.ini text
*.conf text
*.properties text

*.html text
*.css text
*.scss text
*.less text

*.sql text
*.sh text eol=lf
*.ps1 text eol=lf

*.md text
*.txt text
*.csv text
*.graphql text
*.gql text
*.proto text
*.lock text


# ============================================================
# 图片
# SVG 本质是文本格式，保留 diff 能力
# ============================================================

*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.svg text


# ============================================================
# 字体
# ============================================================

*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary


# ============================================================
# 压缩包与编译后二进制
# ============================================================

*.zip binary
*.gz binary
*.7z binary
*.rar binary
*.tar binary

*.jar binary
*.war binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary


# ============================================================
# Office / PDF / 媒体
# ============================================================

*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

*.mp3 binary
*.wav binary
*.flac binary
*.mp4 binary
*.mov binary
*.avi binary
*.mkv binary
